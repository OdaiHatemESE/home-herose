# Frontend (public) configuration — copy to .env.local for development.
# These values are embedded in the static build and are PUBLIC by design.
# NEVER put a secret / service_role key here.

# Supabase project URL: Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — or the legacy "anon" key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Pages project sites are served from /<repo-name>/. Use "/" for a custom domain.
VITE_BASE_PATH=/home-heroes/
