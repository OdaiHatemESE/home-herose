# Edge Function secrets — set with: supabase secrets set --env-file supabase/functions/.env
# Generate with: openssl rand -base64 48
CHILD_CREDENTIAL_PEPPER=replace-with-a-long-random-string-at-least-32-chars
# Optional: restrict CORS to your GitHub Pages origin, e.g. https://<user>.github.io
ALLOWED_ORIGIN=*
# Optional: domain used for children's private internal auth emails
# CHILD_EMAIL_DOMAIN=children.home-heroes.invalid
